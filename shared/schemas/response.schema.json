{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/chowdhuryrifat/bigo-lens/shared/schemas/response.schema.json",
  "title": "BigO Lens engine response",
  "description": "One response written by bigolens-engine to standard output. Protocol version 1.0. See docs/specifications/JSON_PROTOCOL.md.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "request_id", "status", "engine", "results", "diagnostics", "errors"],
  "properties": {
    "schema_version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+$" },
    "request_id": { "type": ["string", "null"] },
    "status": { "enum": ["ok", "error"] },
    "engine": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version", "protocol_version", "frontend"],
      "properties": {
        "name": { "type": "string" },
        "version": { "type": "string" },
        "protocol_version": { "type": "string" },
        "frontend": { "type": ["string", "null"] }
      }
    },
    "results": {
      "anyOf": [{ "type": "null" }, { "$ref": "#/$defs/capabilitiesResults" }, { "$ref": "#/$defs/analyzeResults" }]
    },
    "diagnostics": { "type": "array", "items": { "$ref": "#/$defs/diagnostic" } },
    "errors": { "type": "array", "items": { "$ref": "#/$defs/error" } }
  },
  "allOf": [
    {
      "if": { "type": "object", "properties": { "status": { "const": "error" } }, "required": ["status"] },
      "then": { "type": "object", "properties": { "errors": { "type": "array", "minItems": 1 } } }
    },
    {
      "if": { "type": "object", "properties": { "status": { "const": "ok" } }, "required": ["status"] },
      "then": { "type": "object", "properties": { "errors": { "type": "array", "maxItems": 0 } } }
    }
  ],
  "$defs": {
    "boundStatus": { "enum": ["proven", "estimated", "unknown", "unsupported"] },
    "confidence": { "enum": ["high", "medium", "low", "none"] },
    "feasibilityStatus": { "enum": ["likely_safe", "borderline", "high_risk", "unknown"] },
    "location": {
      "type": "object",
      "additionalProperties": false,
      "required": ["file", "line", "column"],
      "properties": {
        "file": { "type": "string" },
        "line": { "type": "integer", "minimum": 0 },
        "column": { "type": "integer", "minimum": 0 },
        "end_line": { "type": "integer", "minimum": 0 },
        "end_column": { "type": "integer", "minimum": 0 }
      }
    },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "message"],
      "properties": {
        "code": {
          "enum": [
            "malformed_json",
            "request_too_large",
            "invalid_request",
            "unsupported_schema_version",
            "not_implemented",
            "frontend_unavailable",
            "source_parse_error",
            "internal_error"
          ]
        },
        "message": { "type": "string" },
        "path": { "type": "string" }
      }
    },
    "diagnostic": {
      "type": "object",
      "additionalProperties": false,
      "required": ["severity", "message", "location"],
      "properties": {
        "severity": { "enum": ["error", "warning", "information"] },
        "message": { "type": "string" },
        "location": { "anyOf": [{ "type": "null" }, { "$ref": "#/$defs/location" }] }
      }
    },
    "workload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "upper_bound", "method", "assumptions", "missing_bounds"],
      "properties": {
        "status": { "$ref": "#/$defs/boundStatus" },
        "upper_bound": { "type": ["number", "null"] },
        "method": { "type": ["string", "null"] },
        "assumptions": { "type": "array", "items": { "type": "string" } },
        "missing_bounds": { "type": "array", "items": { "type": "string" } }
      }
    },
    "quantity": {
      "anyOf": [
        { "type": "null" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["expression", "asymptotic", "variables", "workload"],
          "properties": {
            "expression": { "type": "string" },
            "asymptotic": { "type": ["string", "null"] },
            "variables": { "type": "array", "items": { "type": "string" } },
            "workload": { "$ref": "#/$defs/workload" }
          }
        }
      ]
    },
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "category",
        "pattern",
        "description",
        "function",
        "location",
        "time",
        "space",
        "bound_status",
        "confidence",
        "assumptions",
        "limitations",
        "provenance"
      ],
      "properties": {
        "id": { "type": "string" },
        "category": {
          "enum": ["loop_nest", "recursion", "static_storage", "dynamic_allocation", "unsupported_construct"]
        },
        "pattern": { "type": "string" },
        "description": { "type": "string" },
        "function": { "type": "string" },
        "location": { "$ref": "#/$defs/location" },
        "time": { "$ref": "#/$defs/quantity" },
        "space": { "$ref": "#/$defs/quantity" },
        "bound_status": { "$ref": "#/$defs/boundStatus" },
        "confidence": { "$ref": "#/$defs/confidence" },
        "assumptions": { "type": "array", "items": { "type": "string" } },
        "limitations": { "type": "array", "items": { "type": "string" } },
        "provenance": { "type": "string" }
      }
    },
    "assessment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "reason"],
      "properties": {
        "status": { "$ref": "#/$defs/feasibilityStatus" },
        "reason": { "type": "string" }
      }
    },
    "analyzeResults": {
      "type": "object",
      "additionalProperties": false,
      "required": ["findings", "memory", "feasibility", "summary"],
      "properties": {
        "findings": { "type": "array", "items": { "$ref": "#/$defs/finding" } },
        "memory": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "static_storage_bytes",
            "static_storage_saturated",
            "largest_local_array_bytes",
            "estimated_minimum_bytes",
            "estimated_minimum_status",
            "assumptions",
            "items"
          ],
          "properties": {
            "static_storage_bytes": { "type": "integer", "minimum": 0 },
            "static_storage_saturated": { "type": "boolean" },
            "largest_local_array_bytes": { "type": "integer", "minimum": 0 },
            "estimated_minimum_bytes": { "type": ["number", "null"] },
            "estimated_minimum_status": { "$ref": "#/$defs/boundStatus" },
            "assumptions": { "type": "array", "items": { "type": "string" } },
            "items": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["name", "kind", "type", "exact_bytes", "symbolic_bytes", "location"],
                "properties": {
                  "name": { "type": "string" },
                  "kind": { "enum": ["global_static", "local_array", "vector_buffer"] },
                  "type": { "type": "string" },
                  "exact_bytes": { "type": ["integer", "null"], "minimum": 0 },
                  "symbolic_bytes": { "type": ["string", "null"] },
                  "location": { "$ref": "#/$defs/location" }
                }
              }
            }
          }
        },
        "feasibility": {
          "type": "object",
          "additionalProperties": false,
          "required": ["time", "memory"],
          "properties": {
            "time": { "$ref": "#/$defs/assessment" },
            "memory": { "$ref": "#/$defs/assessment" }
          }
        },
        "summary": {
          "type": "object",
          "additionalProperties": false,
          "required": ["finding_count", "max_time_workload", "dominant_finding_id", "coverage"],
          "properties": {
            "finding_count": { "type": "integer", "minimum": 0 },
            "max_time_workload": { "type": ["number", "null"] },
            "dominant_finding_id": { "type": ["string", "null"] },
            "coverage": { "enum": ["partial"] }
          }
        }
      }
    },
    "capabilitiesResults": {
      "type": "object",
      "additionalProperties": false,
      "required": ["actions", "features", "stl_cost_model"],
      "properties": {
        "actions": { "type": "array", "items": { "type": "string" } },
        "features": {
          "type": "object",
          "additionalProperties": {
            "enum": ["partial", "unsupported", "data_only", "requires_runtime_estimate", "not_implemented", "supported"]
          }
        },
        "stl_cost_model": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["container", "operation", "average", "worst", "amortized", "note"],
            "properties": {
              "container": { "type": "string" },
              "operation": { "type": "string" },
              "average": { "type": "string" },
              "worst": { "type": "string" },
              "amortized": { "type": "boolean" },
              "note": { "type": "string" }
            }
          }
        }
      }
    }
  }
}
