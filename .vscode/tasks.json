{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "extension: compile",
      "type": "npm",
      "script": "compile",
      "path": "extension",
      "problemMatcher": "$tsc",
      "group": "build"
    },
    {
      "label": "engine: configure (dev)",
      "type": "shell",
      "command": "cmake",
      "args": ["--preset", "dev"],
      "problemMatcher": []
    },
    {
      "label": "engine: build (dev)",
      "type": "shell",
      "command": "cmake",
      "args": ["--build", "--preset", "dev", "--parallel"],
      "problemMatcher": "$gcc",
      "group": { "kind": "build", "isDefault": true }
    },
    {
      "label": "engine: test (dev)",
      "type": "shell",
      "command": "ctest",
      "args": ["--preset", "dev"],
      "problemMatcher": [],
      "group": "test"
    }
  ]
}
